# Copy to .env and fill in. Nothing here is required.

# Signs logins. Left blank, one is made on the first start and kept in
# the data folder. Or make your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Your blog's public address - used for RSS, the sitemap and canonical
# links. Left blank, it's the address you open first-time setup at
# (Settings > Search engines changes it). Set, it wins over Settings.
BASE_URL=

# Only the very first site title; change it later in Settings > General.
SITE_TITLE=My Blog

# Optional: keep images and automatic backups in an S3-compatible
# bucket (S3, Cloudflare R2, Backblaze B2...). See docs/DEPLOYMENT.md.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional: behind Cloudflare (or another CDN/proxy that names the
# visitor in a header), use that header for rate limiting.
# CLIENT_IP_HEADER=CF-Connecting-IP

# Optional: the largest audio/video upload, in MB (default 100).
# MAX_MEDIA_MB=100

# Optional: how long a login lasts unused, in days (default 14).
# SESSION_DAYS=14

# Optional: the Update now button with Watchtower (docker-compose.yml).
# A long random string - put the same one in Settings > Integrations > Updates.
# WATCHTOWER_HTTP_API_TOKEN=
